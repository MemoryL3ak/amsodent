# ─────────────────────────────────────────────────────────────────────────
# Backend · AMBIENTE DE PRUEBAS (rama "test" de Supabase + servicio "test" en Railway)
# Copia este archivo como variables del environment de pruebas en Railway
# (o como backend/.env si quieres apuntar el backend local a pruebas).
# Ninguna línea trae secretos: los valores van en Railway, nunca en git.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (RAMA test: URL y claves DISTINTAS a producción) ──────────────
# Dashboard → rama "test" → Project Settings → API.
SUPABASE_URL=https://<ref-de-la-rama>.supabase.co
SUPABASE_ANON_KEY=<anon key de la rama>
SUPABASE_SERVICE_ROLE_KEY=<service role key de la rama>

# ── Red ──────────────────────────────────────────────────────────────────
PORT=3001
# Dominio del FRONTEND de pruebas (Vercel). Sin esto el backend bloquea todo
# origen cruzado (fail-closed). Varios dominios separados por coma.
CORS_ORIGIN=https://amsodent-test.vercel.app

# ── URLs públicas que el sistema pone en correos, QR y enlaces ───────────
PUBLIC_APP_URL=https://amsodent-test.vercel.app
APP_PUBLIC_URL=https://amsodent-test.vercel.app
FRONTEND_URL=https://amsodent-test.vercel.app
PORTAL_URL=https://amsodent-test.vercel.app
PUBLIC_API_URL=https://<backend-test>.up.railway.app/api

# ── Secretos propios de pruebas (NO reutilizar los de producción) ────────
PORTAL_JWT_SECRET=<genera uno nuevo>
PORTAL_STOCK_JWT_SECRET=<genera uno nuevo>
PORTAL_CHOFER_JWT_SECRET=<genera uno nuevo>

# ── Crones: APAGADOS en pruebas (si no, compiten con producción por los
#    límites de Bsale, Mercado Público y Google Calendar) ─────────────────
BSALE_SYNC_AUTO=off
MP_SYNC_AUTO=off
MP_EXPLORAR_AUTO=off
MP_ESTADOS_AUTO=off
CALENDAR_SYNC_AUTO=off

# ── Integraciones externas ───────────────────────────────────────────────
# Bsale: SOLO lectura desde el sistema, pero comparte el rate limit con
# producción. Déjalo vacío salvo que estés probando Inventario/Trazabilidad.
BSALE_ACCESS_TOKEN=
# Mercado Público (solo lectura): se pueden reutilizar los tickets.
MERCADO_PUBLICO_TICKET=
MP_API_TICKET=
MP_RUT_EMPRESA=
# Correo: casilla de PRUEBAS. Con la de producción, cobranza, eventos y
# comunidad mandan correos reales a clientes.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Amsodent PRUEBAS
MONITOR_ALERTA_CORREO=
# WhatsApp: vacío, o el chat escribe al grupo real.
WHATSAPP_GA_URL=
WHATSAPP_GA_INSTANCE=
WHATSAPP_GA_TOKEN=
WHATSAPP_GROUP_ID=
WHATSAPP_WEBHOOK_SECRET=
# Webpay: ambiente de INTEGRACIÓN con las credenciales de prueba de Transbank.
TBK_AMBIENTE=integracion
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Google (Gmail/Calendar/Workspace): registrar en Google Cloud una redirect
# URI para el dominio de pruebas y ponerla aquí.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<backend-test>.up.railway.app/api/correos/oauth/callback
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_API_KEY=
# IA y voz: pueden reutilizarse (consumen del mismo saldo).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EQUIV_AVISO=

# ── RRHH (parámetros legales; mismos valores que producción) ─────────────
RRHH_UF=
RRHH_UTM=
RRHH_IMM=
RRHH_TASA_AFP=
RRHH_TOPE_IMPONIBLE_UF=
RRHH_TOPE_CESANTIA_UF=
