SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
PORT=3001
CORS_ORIGIN=https://amsodent.vercel.app

# ── SMTP (envíos masivos desde cuenta central, p.ej. campañas/sorteos) ──────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Google OAuth (envío de correos via Gmail API en nombre del usuario) ─────
# Crear en Google Cloud Console > APIs & Services > Credentials > OAuth 2.0
# Scope necesario habilitado: https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI registrado en la consola. Debe coincidir EXACTAMENTE.
# En dev:  http://localhost:3001/api/auth/google/callback
# En prod: https://<tu-backend-railway>.up.railway.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Secret extra para firmar el state OAuth (HMAC). Usa una cadena aleatoria
# larga (ej: `openssl rand -hex 32`). Si lo dejas vacío, el backend cae al
# PORTAL_JWT_SECRET o al SERVICE_ROLE_KEY como fallback.
GOOGLE_OAUTH_STATE_SECRET=

# URL pública del frontend (para redirigir al usuario tras el callback OAuth).
# En dev:  http://localhost:5173
# En prod: https://amsodent.vercel.app
FRONTEND_URL=http://localhost:5173

# Portal cliente (firma de JWT que reciben los clientes)
PORTAL_JWT_SECRET=
