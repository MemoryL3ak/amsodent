# URL base del backend NestJS de Amsodent (incluye el prefijo /api, sin slash final)
# Ejemplo producción: https://api.amsodent.cl/api
# Ejemplo local (emulador Android): http://10.0.2.2:3001/api
# Ejemplo local (simulador iOS / Expo Go en la misma red): http://TU-IP-LOCAL:3001/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Credenciales de Supabase (las mismas VITE_SUPABASE_* del frontend web)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
