# ─────────────────────────────────────────────────────────────────────────
# Frontend · AMBIENTE DE PRUEBAS (Vercel, rama "test")
# Estas variables van en Vercel → proyecto de pruebas (o Preview de la rama
# "test") → Environment Variables. Para correr el frontend local contra
# pruebas, copia este archivo como .env.local.
# ─────────────────────────────────────────────────────────────────────────

# Supabase: RAMA test (URL y anon key distintas a producción).
VITE_SUPABASE_URL=https://<ref-de-la-rama>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key de la rama>

# Backend de pruebas (Railway, environment "test"), con el prefijo /api.
VITE_API_URL=https://<backend-test>.up.railway.app/api

# Dominio del propio frontend de pruebas (QR, enlaces del portal).
VITE_PORTAL_URL=https://amsodent-test.vercel.app

# Puede reutilizarse (consume del mismo saldo).
VITE_GOOGLE_MAPS_API_KEY=

# Días que muestra el monitoreo del sistema (opcional).
VITE_MONITOR_DIAS=7
